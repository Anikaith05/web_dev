<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YelpCamp</title>
		<style>
			:root {
				--bg: #0f1720;
				--bg-2: #111b27;
				--panel: #172330;
				--panel-2: #1d2d3d;
				--accent: #7cd7a6;
				--accent-dark: #58b183;
				--text: #edf3f8;
				--muted: #b8c5d1;
				--border: #2d3d4d;
				--shadow: rgba(5, 10, 15, 0.45);
			}

			* { box-sizing: border-box; }

			body {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				background: linear-gradient(135deg, var(--bg), var(--bg-2));
				color: var(--text);
			}

			.container {
				max-width: 720px;
				margin: 70px auto;
				padding: 0 24px;
			}

			.form-card {
				background: var(--panel);
				border: 1px solid var(--border);
				border-radius: 22px;
				padding: 34px;
				box-shadow: 0 18px 40px var(--shadow);
			}

			h1 {
				margin: 0 0 24px;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
			}

			form {
				display: flex;
				flex-direction: column;
				gap: 18px;
			}

			.field {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			label {
				font-weight: 700;
				color: var(--text);
			}

			input {
				padding: 12px 14px;
				border: 1px solid var(--border);
				border-radius: 10px;
				font-size: 1rem;
				background: var(--panel-2);
				color: var(--text);
			}

			input::placeholder {
				color: var(--muted);
			}

			input:focus {
				outline: 2px solid rgba(124, 215, 166, 0.18);
				border-color: var(--accent);
			}

			button {
				margin-top: 10px;
				padding: 14px 18px;
				border: none;
				border-radius: 12px;
				background: var(--accent);
				color: #0f1720;
				font-size: 1rem;
				font-weight: 700;
				cursor: pointer;
				box-shadow: 0 12px 24px rgba(124, 215, 166, 0.2);
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="form-card">
				<h1>Add a Campground</h1>
				<form action="/campground" method="POST">
					<div class="field">
						<label for="city">City</label>
						<input id="city" type="text" name="city" placeholder="Enter city name" />
					</div>
					<div class="field">
						<label for="state">State</label>
						<input id="state" type="text" name="state" placeholder="Enter state name" />
					</div>
					<button type="submit">Submit</button>
				</form>
			</div>
		</div>
	</body>
</html>
