<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YelpCamp</title>
		<style>
			:root {
				--bg: #0f1720;
				--bg-2: #111b27;
				--panel: #172330;
				--panel-2: #1d2d3d;
				--accent: #7cd7a6;
				--accent-dark: #58b183;
				--text: #edf3f8;
				--muted: #b8c5d1;
				--border: #2d3d4d;
				--shadow: rgba(5, 10, 15, 0.45);
			}

			* { box-sizing: border-box; }

			body {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				background: linear-gradient(135deg, var(--bg), var(--bg-2));
				color: var(--text);
			}

			.container {
				max-width: 960px;
				margin: 80px auto;
				padding: 0 24px;
			}

			.hero {
				background: var(--panel);
				border: 1px solid var(--border);
				border-radius: 22px;
				padding: 52px 40px;
				box-shadow: 0 18px 40px var(--shadow);
				text-align: center;
			}

			.eyebrow {
				display: inline-block;
				padding: 8px 14px;
				background: rgba(124, 215, 166, 0.16);
				color: var(--accent);
				border-radius: 999px;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin-bottom: 18px;
			}

			h1 {
				margin: 0;
				font-size: clamp(2.1rem, 4vw, 4rem);
				line-height: 1.1;
			}

			.subtitle {
				max-width: 640px;
				margin: 18px auto 0;
				font-size: 1.08rem;
				color: var(--muted);
				line-height: 1.7;
			}

			.actions {
				display: flex;
				justify-content: center;
				gap: 16px;
				margin-top: 30px;
				flex-wrap: wrap;
			}

			.btn {
				display: inline-block;
				padding: 14px 22px;
				border-radius: 12px;
				text-decoration: none;
				font-weight: 700;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.btn:hover {
				transform: translateY(-1px);
			}

			.btn-primary {
				background: var(--accent);
				color: #0f1720;
				box-shadow: 0 12px 24px rgba(124, 215, 166, 0.22);
			}

			.btn-secondary {
				background: var(--panel-2);
				color: var(--text);
				border: 1px solid var(--border);
			}
		</style>
	</head>
	<body>
		<div class="container">
			<section class="hero">
				<div class="eyebrow">YelpCamp</div>
				<h1>Find your next favorite camping spot.</h1>
				<p class="subtitle">
					Explore beautiful places, discover hidden gems, and keep track of the campgrounds you want to visit.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="/campground">View Campgrounds</a>
					<a class="btn btn-secondary" href="/ncampground">Add New Campground</a>
				</div>
			</section>
		</div>
	</body>
</html>
