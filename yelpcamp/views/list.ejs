<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YelpCamp</title>
		<style>
			:root {
				--bg: #0f1720;
				--bg-2: #111b27;
				--panel: #172330;
				--panel-2: #1d2d3d;
				--accent: #7cd7a6;
				--accent-dark: #58b183;
				--text: #edf3f8;
				--muted: #b8c5d1;
				--border: #2d3d4d;
				--shadow: rgba(5, 10, 15, 0.45);
			}

			* { box-sizing: border-box; }

			body {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				background: linear-gradient(135deg, var(--bg), var(--bg-2));
				color: var(--text);
			}

			.container {
				max-width: 960px;
				margin: 60px auto;
				padding: 0 24px;
			}

			.page-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 20px;
				margin-bottom: 28px;
				flex-wrap: wrap;
			}

			h1 {
				margin: 0;
				font-size: clamp(2rem, 3vw, 3rem);
			}

			.btn {
				display: inline-block;
				padding: 12px 18px;
				border-radius: 12px;
				text-decoration: none;
				font-weight: 700;
				background: var(--accent);
				color: #0f1720;
				box-shadow: 0 10px 20px rgba(124, 215, 166, 0.18);
			}

			.list-panel {
				background: var(--panel);
				border: 1px solid var(--border);
				border-radius: 20px;
				box-shadow: 0 18px 40px var(--shadow);
				padding: 24px;
			}

			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			li {
				margin-bottom: 14px;
			}

			li:last-child {
				margin-bottom: 0;
			}

			.camp-link {
				display: block;
				padding: 16px 18px;
				border: 1px solid var(--border);
				border-radius: 12px;
				background: var(--panel-2);
				color: var(--text);
				text-decoration: none;
				font-size: 1.05rem;
				font-weight: 600;
				transition: border-color 0.2s ease, transform 0.2s ease;
			}

			.camp-link:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="page-header">
				<h1>Campgrounds</h1>
				<a class="btn" href="/ncampground">Add New Campground</a>
			</div>

			<div class="list-panel">
				<ul>
					<% for(let camp of camps){ %>
						<li>
							<a class="camp-link" href="/campground/<%=camp._id%>"><%=camp.city%></a>
						</li>
					<%}%>
				</ul>
			</div>
		</div>
	</body>
</html>
